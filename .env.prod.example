# Copy this file to .env on the server and replace every CHANGE_ME value.
# Never commit the resulting .env file.

# The deploy workflow overrides this with the commit SHA. Keep main for manual
# docker compose deployments that should follow the rolling main tag.
AGENTYARD_IMAGE_TAG=main

# PostgreSQL settings for the bundled postgres:16-alpine service.
POSTGRES_USER=agentyard
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=agentyard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: use this instead of the POSTGRES_* connection settings when
# DATABASE_URL points at an external PostgreSQL service.
# DATABASE_URL=ecto://agentyard:CHANGE_ME@db:5432/agentyard
DATABASE_SSL=false
POOL_SIZE=10

# Required Phoenix and application secrets. Generate unique values for each
# installation; do not reuse the development/demo values from docker-compose.yml.
SECRET_KEY_BASE=CHANGE_ME_generate_a_long_random_secret_key_base
AGENTYARD_SECRET_KEY=CHANGE_ME_generate_a_long_random_encryption_key

# Public URL configuration.
PHX_HOST=your-domain.example
PORT=4000
PHX_SERVER=true
DEMO_MODE=false

# SMTP settings for passwordless sign-in email.
MAILER_FROM=you@example.com
MAILER_FROM_NAME=AgentYard
SMTP_RELAY=smtp.example.com
SMTP_USERNAME=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_PORT=587
SMTP_TLS=always
SMTP_AUTH=always
SMTP_SSL=false

# Only needed when starting the optional Caddy service with
# COMPOSE_PROFILES=caddy. Caddy uses this hostname for automatic HTTPS.
# DOMAIN=your-domain.example
