ARG ELIXIR_VERSION=1.18.4
ARG OTP_VERSION=28

FROM elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION} AS builder

ARG MIX_ENV=prod

ENV MIX_ENV=${MIX_ENV} \
    LANG=C.UTF-8 \
    ERL_AFLAGS="-kernel shell_history enabled"

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends build-essential git nodejs npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock ./
RUN mix deps.get --only ${MIX_ENV}

COPY assets/package.json assets/package-lock.json ./assets/
RUN npm ci --prefix assets

COPY config ./config
COPY lib ./lib
COPY priv ./priv
COPY assets/js ./assets/js

RUN mix assets.deploy \
    && mix compile \
    && mix release

FROM debian:bookworm-slim AS runner

ENV LANG=C.UTF-8 \
    MIX_ENV=prod \
    HOME=/home/agentyard

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends ca-certificates curl libncurses6 libstdc++6 openssl \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system agentyard \
    && adduser --system --ingroup agentyard --home /home/agentyard agentyard

WORKDIR /app

COPY --from=builder --chown=agentyard:agentyard /app/_build/prod/rel/agentyard ./
COPY --chown=agentyard:agentyard docker-entrypoint.sh ./

USER agentyard

EXPOSE 4000

CMD ["/bin/sh", "/app/docker-entrypoint.sh"]
