<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title><%= assigns[:page_title] || "AgentYard" %></title>
    <link rel="stylesheet" href={~p"/css/app.css"} />
    <link rel="stylesheet" href={~p"/css/polish.css"} />
    <script defer phx-track-static src={~p"/js/app.js"}></script>
  </head>
  <body>
    <%= @inner_content %>
  </body>
</html>
